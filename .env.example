PORT=3000
# Required: password for /admin (the only place the guest list is visible)
ADMIN_PASSWORD=change-me
# Public URL used in WhatsApp messages
PUBLIC_URL=https://your-domain.com
# Directory for db.json + uploaded images/music (mount a persistent volume in production)
DATA_DIR=./data
# Used when guests enter numbers without a country code, e.g. 1 or 91
DEFAULT_COUNTRY_CODE=

# WhatsApp via Twilio (optional – without it, the dashboard offers click-to-chat links)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# Optional approved WhatsApp template (needed to message guests outside the 24h window).
# Create a template whose body is just {{1}}.
TWILIO_CONTENT_SID=
