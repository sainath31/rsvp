# ---- Required in production ----
# Your host password (you choose it). 10+ characters. Used at the profile icon / /admin.
ADMIN_PASSWORD=
# Any long random text. Signs the host login cookie. (Changing ADMIN_PASSWORD also signs everyone out.)
SESSION_SECRET=
# The public address of the site, used inside emails and calendar entries. No trailing slash.
PUBLIC_URL=https://your-site.vercel.app

# ---- Email (Gmail) ----
# Create an App password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Mamatha Devi & Sainath
# MAIL_DRY_RUN=1   # log emails instead of sending (testing)

# ---- Vercel only (added automatically when you connect the storage, except CRON_SECRET) ----
# Upstash Redis (guest list + event settings)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob (optional: uploads from the dashboard)
BLOB_READ_WRITE_TOKEN=
# Any long random text. Vercel Cron sends it so only Vercel can trigger the daily reminder job.
CRON_SECRET=

# ---- Local / own server only ----
PORT=3000
# Folder for db.json + uploads. Use a persistent disk in production (Render, Fly, a VPS).
DATA_DIR=./data
NODE_ENV=production
