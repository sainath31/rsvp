PORT=3000
# Required: password for /admin (the only place the guest list is visible)
ADMIN_PASSWORD=change-me
# Public URL used in emails and calendar entries
PUBLIC_URL=https://your-domain.com
# Directory for db.json + uploaded images/music (mount a persistent volume in production)
DATA_DIR=./data

# Email via Gmail (recommended, free). Create an App password:
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Your Names
